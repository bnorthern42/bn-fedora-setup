#ListAllCommands | grep searchstr
function ListAllCommands
{
    COMMANDS=`echo -n $PATH | xargs -d : -I {} find {} -maxdepth 1 \
        -executable -type f -printf '%P\n'`
    ALIASES=`acs`
    echo "ALIASES*****************************************************$ALIASES"
        echo '\n******************************************************\n'
        echo "COMMANDS\n******************************************************$COMMANDS" | sort | uniq | pr -3 -t
}


